# GEMINI_API_KEY: Optional Gemini AI API key injected server-side if AI endpoints are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GridGuard AI Core Server Configuration
NODE_ENV="development"
PORT=3000

# PostgreSQL + PostGIS Relational Database
POSTGRES_USER="gridguard"
POSTGRES_PASSWORD="CHANGE_ME_IN_PRODUCTION_DB_PASSWORD"
POSTGRES_DB="gridguard_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://gridguard:CHANGE_ME_IN_PRODUCTION_DB_PASSWORD@localhost:5432/gridguard_db"

# Neo4j Knowledge Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="CHANGE_ME_IN_PRODUCTION_NEO4J_PASSWORD"

# Demo Mode & Telemetry Provider
# Set ENABLE_DEMONSTRATION_MODE="false" in strict production environments to disable synthetic demo triggers & demo tokens.
ENABLE_DEMONSTRATION_MODE="true"
VITE_TELEMETRY_PROVIDER="simulated"
OPENDSS_EXECUTABLE_PATH=""

# Mapbox Public Access Token (required for Mapbox Streets / Dark / Satellite basemaps)
VITE_MAPBOX_ACCESS_TOKEN="YOUR_MAPBOX_PUBLIC_ACCESS_TOKEN"

# FastAPI + PostGIS Backend Configuration
# Override JWT_SECRET_KEY with at least 32 random bytes in production (e.g., `openssl rand -hex 32`).
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION_USE_ENV_SECRET"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional external GIS FastAPI backend base URL when deployed separately from port 3000
VITE_API_BASE_URL=""
